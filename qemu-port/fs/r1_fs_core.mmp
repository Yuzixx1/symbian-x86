// Proposed host MMP. Shared host integrator owns the entry point, exact
// process identity, backend source and final startup sequencing.
TARGET          portfilesrv.exe
TARGETTYPE      EXE
SOURCEPATH      .
SOURCE          r1_fs_core.cpp r1_fs_server.cpp
USERINCLUDE     .
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
// Proposed host capability envelope from genuine sfile/group/f32caps.mmh:
// TCB for server service, ProtServ for !FileServer, DiskAdmin for FAT device,
// AllFiles for trusted staging/metadata, PowerMgmt/CommDD for lower disk path.
// Coordinator must select minimal actual host imports/policy before link.
CAPABILITY      TCB ProtServ DiskAdmin AllFiles PowerMgmt CommDD
LIBRARY         euser.lib
// Not a standalone build recipe: linking requires the injected backend and
// shared host bootstrap. No E32Main is defined in this owned component.
UID             0x1000007A 0xE1A0F015 // placeholder UID3; coordinator replaces
VENDORID        0x70000001
