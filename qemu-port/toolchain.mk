# toolchain.mk — modern Linux toolchain for the genuine EKA2 x86 slice.
# Replaces: bldmake / ActivePerl / MSVC+MASM. No Windows host required.
#
# Proven on: gcc 16.2.1, binutils 2.46.1, qemu 10.2.2 (Fedora 44, x86_64 host).
# Freestanding only: -nostdlib means NO 32-bit glibc (glibc-devel.i686) is needed.

CC      := gcc
CXX     := g++
AS      := as
LD      := ld
OBJCOPY := objcopy
QEMU    := qemu-system-i386

# -- 32-bit IA32 target, Pentium-era baseline (EKA2 x86 assumes 486+; QEMU default is fine).
ARCH_FLAGS := -m32 -march=i486 -mtune=generic

# -- Freestanding kernel flags. -D__GCC32__ selects the genuine GCC branches
#    already present in every .cia file (e.g. nkern/x86/vectors.cia, ncsched.cia)
#    and in x86hlp_gcc.inl / cpudefs.h (__NAKED__ is empty on GCC/x86).
KERNEL_CDEFS := -D__GCC32__ -D__X86__ -DCFG_MMDirect -DQEMU_PORT

WARN := -Wall -Wextra -Wno-unused-parameter -Wno-multichar

# NOTE: plat_priv.h / variant headers are normally GENERATED by bldmake export.
# Phase 3 supplies a minimal hand-written plat_priv.h shim in qemu-port/inc/.
# Until then only the bridge stub (which needs no EKA2 headers) is compiled.
KERNEL_INCLUDES := \
  -I$(EKA)/include \
  -I$(EKA)/include/kernel/x86 \
  -I$(EKA)/include/nkern/x86 \
  -I$(QPORT)/inc

CFLAGS   := $(ARCH_FLAGS) -ffreestanding -nostdlib -fno-builtin \
            -fno-pic -fno-pie -fno-stack-protector \
            -fno-exceptions -fno-rtti -fno-threadsafe-statics \
            -mno-red-zone -mno-mmx -mno-sse \
            -O2 $(WARN) $(KERNEL_CDEFS)

CXXFLAGS := $(CFLAGS)

# GAS assembles our hand-ported .S files (Intel syntax via .intel_syntax).
ASFLAGS := --32 -march=i486

LDFLAGS := -m elf_i386 -nostdlib -static
